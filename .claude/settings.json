{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit",
      "Glob",
      "Grep",
      "Read",
      "WebFetch",
      "WebSearch",
      "Write",
      "Skill(release-toolbox)",
      "Skill(xh:clear-writing)",
      "Skill(xh:hoist-upgrade)",
      "Skill(xh:onboard-app)",
      "Skill(xh:right-size)",
      "Skill(xh:setup-worktree)",
      "Skill(xh:using-hoist-core-reference)",
      "Skill(xh:using-hoist-react-reference)",
      "mcp__hoist-docs__*"
    ],
    "additionalDirectories": [
      "../hoist-core",
      "../hoist-react"
    ]
  },
  "enabledMcpjsonServers": [
    "hoist-docs"
  ],
  "enabledPlugins": {
    "xh@hoist-ai": true,
    "typescript-lsp@claude-plugins-official": true,
    "jdtls-lsp@claude-plugins-official": true
  },
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "extraKnownMarketplaces": {
    "hoist-ai": {
      "source": {
        "source": "github",
        "repo": "xh/hoist-ai"
      },
      "autoUpdate": true
    }
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
