{
  "mcpServers": {
    "hoist-docs": {
      "type": "stdio",
      "command": "node",
      "args": ["client-app/node_modules/@xh/hoist-docs/bin/hoist-docs.mjs"],
      "env": {"INDEX_DIR": "${HOIST_DOCS_INDEX_DIR:-}"}
    },
    "github": {
      "command": "bash",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=\"$(gh auth token)\" exec docker run -i --rm -e GITHUB_PERSONAL_ACCESS_TOKEN ghcr.io/github/github-mcp-server"
      ]
    },
    "idea": {
      "url": "http://127.0.0.1:64342/stream",
      "type": "http"
    }
  }
}
