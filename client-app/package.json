{
  "name": "toolbox",
  "version": "11.0-SNAPSHOT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "rsbuild build --env-mode prod",
    "buildAndAnalyze": "cross-env XH_ANALYZE_BUNDLES=true rsbuild build --env-mode prod",
    "hoistVer": "cat node_modules/@xh/hoist/package.json | grep version",
    "lint": "pnpm lint:all",
    "validateDocs": "node scripts/validate-doc-registry.mjs",
    "lint:all": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky client-app/.husky",
    "start": "pnpm install && rsbuild dev",
    "startAndAnalyze": "cross-env XH_ANALYZE_BUNDLES=true pnpm start",
    "startWithIp": "XH_DEV_HOST=$(ipconfig getifaddr en0) pnpm start",
    "startWithHoist": "(cd ../../hoist-react && pnpm install) && pnpm install && rsbuild dev --env-mode inlineHoist",
    "startWithHoistAndAnalyze": "cross-env XH_ANALYZE_BUNDLES=true pnpm startWithHoist",
    "startWithHoistAndIp": "XH_DEV_HOST=$(ipconfig getifaddr en0) pnpm startWithHoist",
    "startWithHoistSecure": "cross-env XH_DEV_HTTPS=true XH_DEV_HOST=toolbox-local.xh.io pnpm startWithHoist"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@xh/hoist": "next",
    "@xh/package-template": "~3.0.4",
    "ag-charts-community": "~14.1.0",
    "ag-grid-community": "~36.1.0",
    "ag-grid-enterprise": "~36.1.0",
    "ag-grid-react": "~36.1.0",
    "classnames": "~2.5.1",
    "core-js": "~3.50.0",
    "filesize": "~11.0.23",
    "highcharts": "~12.6.0",
    "lodash": "~4.18.1",
    "minisearch": "^7.2.0",
    "moment": "~2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/lodash": "~4.17.25",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@xh/eslint-config": "^8.0.1",
    "@xh/hoist-dev-utils": "16.0.0-SNAPSHOT.1789745757649",
    "cross-env": "~10.1.0",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "~10.1.8",
    "husky": "~9.1.7",
    "lint-staged": "~17.3.0",
    "postcss": "~8.5.28",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "stylelint-config-recommended-scss": "~17.0.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
