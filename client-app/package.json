{
  "name": "toolbox",
  "version": "10.0-SNAPSHOT",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "webpack --env prodBuild",
    "buildAndAnalyze": "webpack --env prodBuild --env analyzeBundles",
    "hoistVer": "cat node_modules/@xh/hoist/package.json | grep version",
    "lint": "pnpm lint:all",
    "validateDocs": "node scripts/validate-doc-registry.mjs",
    "lint:all": "pnpm lint:code && pnpm lint:styles",
    "lint:code": "eslint .",
    "lint:styles": "stylelint \"**/*.s?(a|c)ss\"",
    "typecheck": "tsc --noEmit",
    "prepare": "cd .. && husky client-app/.husky",
    "start": "pnpm install && cross-env NODE_OPTIONS=--max_old_space_size=3072 webpack-dev-server",
    "startAndAnalyze": "pnpm start --env analyzeBundles",
    "startWithIp": "pnpm start --env devHost=$(ipconfig getifaddr en0)",
    "startWithHoist": "(cd ../../hoist-react && pnpm install) && pnpm install && cross-env NODE_OPTIONS=--max_old_space_size=3072 webpack-dev-server --env inlineHoist",
    "startWithHoistAndAnalyze": "pnpm startWithHoist --env analyzeBundles",
    "startWithHoistAndIp": "pnpm startWithHoist --env devHost=$(ipconfig getifaddr en0)",
    "startWithHoistSecure": "pnpm startWithHoist --env devHttps=true --env devHost=toolbox-local.xh.io"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "*.s?(a|c)ss": [
      "prettier --write",
      "stylelint"
    ]
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/pro-regular-svg-icons": "^7.3.1",
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans": "^1.1.0",
    "@xh/hoist": "87.0.0",
    "@xh/package-template": "~3.0.4",
    "ag-charts-community": "~13.3.1",
    "ag-grid-community": "~35.3.1",
    "ag-grid-enterprise": "~35.3.1",
    "ag-grid-react": "~35.3.1",
    "classnames": "~2.5.1",
    "core-js": "~3.50.0",
    "filesize": "~11.0.22",
    "highcharts": "~12.6.0",
    "lodash": "~4.18.1",
    "minisearch": "^7.2.0",
    "moment": "~2.30.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/lodash": "~4.17.25",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.5",
    "@xh/hoist-dev-utils": "^14.0.1",
    "cross-env": "~10.1.0",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "~10.1.8",
    "husky": "~9.1.7",
    "lint-staged": "~17.3.0",
    "postcss": "~8.5.26",
    "prettier": "~3.9.6",
    "stylelint": "~17.14.1",
    "stylelint-config-recommended-scss": "~17.0.1",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
