{
    "schema": {
        "blueprint": 1,
        "widgets": {"panel": 1, "variableInput": 1, "dashboard": 1, "tileFrame": 1, "statCard": 1, "chart": 1}
    },
    "variables": {
        "city": {
            "type": "string",
            "label": "City",
            "setBy": "prompt",
            "default": {"value": "London"},
            "options": {"values": ["Chicago", "London", "New York", "Paris", "Sydney", "Tokyo"]}
        },
        "units": {"type": "string", "label": "Units", "default": {"value": "metric"}}
    },
    "sources": {
        "current": {"dataset": "currentWeather", "params": {"city": {"$var": "city"}, "units": {"$var": "units"}}},
        "forecast": {"dataset": "weather", "params": {"city": {"$var": "city"}, "units": {"$var": "units"}}}
    },
    "root": "page",
    "elements": {
        "page": {"component": "panel", "tbar": [{"id": "cityInput"}], "children": [{"id": "dashboard"}]},
        "cityInput": {"component": "variableInput", "config": {"variable": "city"}},
        "dashboard": {
            "component": "dashboard",
            "children": [
                {"id": "now", "x": 0, "y": 0, "w": 12, "h": 2},
                {"id": "tempChart", "x": 0, "y": 2, "w": 12, "h": 6}
            ]
        },
        "now": {
            "component": "tileFrame",
            "config": {"title": {"$var": "city"}},
            "children": [
                {"id": "nowConditions"},
                {"id": "nowTemp"},
                {"id": "nowFeelsLike"},
                {"id": "nowHumidity"},
                {"id": "nowWindSpeed"}
            ]
        },
        "nowConditions": {"component": "statCard", "config": {"source": "current", "field": "conditions"}},
        "nowTemp": {"component": "statCard", "config": {"source": "current", "field": "temp"}},
        "nowFeelsLike": {"component": "statCard", "config": {"source": "current", "field": "feelsLike"}},
        "nowHumidity": {"component": "statCard", "config": {"source": "current", "field": "humidity"}},
        "nowWindSpeed": {"component": "statCard", "config": {"source": "current", "field": "windSpeed"}},
        "tempChart": {
            "component": "chart",
            "config": {
                "source": "forecast",
                "title": "Temperature (°C)",
                "type": "line",
                "x": "time",
                "y": ["temp", "feelsLike"]
            }
        }
    }
}
