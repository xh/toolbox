{
    "schema": {
        "blueprint": 1,
        "widgets": {
            "dashCanvas": 1,
            "markdown": 1,
            "buttonGroupInput": 1,
            "gauge": 1,
            "tileFrame": 1,
            "statCard": 1,
            "chart": 1
        }
    },
    "variables": {
        "cityA": {
            "type": "string",
            "label": "City A",
            "setBy": "prompt",
            "default": {
                "value": "New York"
            },
            "options": {
                "values": [
                    "Chicago",
                    "London",
                    "New York",
                    "Paris",
                    "Sydney",
                    "Tokyo"
                ]
            }
        },
        "cityB": {
            "type": "string",
            "label": "City B",
            "setBy": "prompt",
            "default": {
                "value": "London"
            },
            "options": {
                "values": [
                    "Chicago",
                    "London",
                    "New York",
                    "Paris",
                    "Sydney",
                    "Tokyo"
                ]
            }
        },
        "units": {
            "type": "string",
            "label": "Units",
            "setBy": {
                "element": "unitsToggle"
            },
            "default": {
                "value": "metric"
            }
        }
    },
    "sources": {
        "currentA": {
            "dataset": "currentWeather",
            "params": {
                "city": {
                    "$var": "cityA"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "forecastA": {
            "dataset": "weather",
            "params": {
                "city": {
                    "$var": "cityA"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "currentB": {
            "dataset": "currentWeather",
            "params": {
                "city": {
                    "$var": "cityB"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "forecastB": {
            "dataset": "weather",
            "params": {
                "city": {
                    "$var": "cityB"
                },
                "units": {
                    "$var": "units"
                }
            }
        }
    },
    "root": "dashboard",
    "elements": {
        "dashboard": {
            "component": "dashCanvas",
            "children": [
                {
                    "id": "title",
                    "x": 0,
                    "y": 0,
                    "w": 9,
                    "h": 2
                },
                {
                    "id": "unitsToggle",
                    "x": 9,
                    "y": 0,
                    "w": 3,
                    "h": 1
                },
                {
                    "id": "gaugeA",
                    "x": 0,
                    "y": 2,
                    "w": 3,
                    "h": 4
                },
                {
                    "id": "nowA",
                    "x": 3,
                    "y": 2,
                    "w": 3,
                    "h": 4
                },
                {
                    "id": "gaugeB",
                    "x": 6,
                    "y": 2,
                    "w": 3,
                    "h": 4
                },
                {
                    "id": "nowB",
                    "x": 9,
                    "y": 2,
                    "w": 3,
                    "h": 4
                },
                {
                    "id": "tempChartA",
                    "x": 0,
                    "y": 6,
                    "w": 6,
                    "h": 5
                },
                {
                    "id": "tempChartB",
                    "x": 6,
                    "y": 6,
                    "w": 6,
                    "h": 5
                },
                {
                    "id": "precipChartA",
                    "x": 0,
                    "y": 11,
                    "w": 12,
                    "h": 4
                }
            ]
        },
        "gaugeA": {
            "component": "gauge",
            "config": {
                "source": "currentA",
                "title": {
                    "$var": "cityA"
                },
                "value": "temp",
                "min": -10,
                "max": 40,
                "stops": [
                    {
                        "at": 0,
                        "color": "#4575b4"
                    },
                    {
                        "at": 0.5,
                        "color": "#fee090"
                    },
                    {
                        "at": 1,
                        "color": "#d73027"
                    }
                ]
            }
        },
        "nowA": {
            "component": "tileFrame",
            "children": [
                {
                    "id": "nowAConditions"
                },
                {
                    "id": "nowAFeelsLike"
                },
                {
                    "id": "nowAHumidity"
                },
                {
                    "id": "nowAWind"
                }
            ]
        },
        "nowAConditions": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "conditions"
            }
        },
        "nowAFeelsLike": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "feelsLike"
            }
        },
        "nowAHumidity": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "humidity"
            }
        },
        "nowAWind": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "windSpeed"
            }
        },
        "tempChartA": {
            "component": "chart",
            "config": {
                "source": "forecastA",
                "title": "Temperature",
                "type": "line",
                "x": "time",
                "y": [
                    "temp",
                    "feelsLike"
                ]
            }
        },
        "gaugeB": {
            "component": "gauge",
            "config": {
                "source": "currentB",
                "title": {
                    "$var": "cityB"
                },
                "value": "temp",
                "min": -10,
                "max": 40,
                "stops": [
                    {
                        "at": 0,
                        "color": "#4575b4"
                    },
                    {
                        "at": 0.5,
                        "color": "#fee090"
                    },
                    {
                        "at": 1,
                        "color": "#d73027"
                    }
                ]
            }
        },
        "nowB": {
            "component": "tileFrame",
            "children": [
                {
                    "id": "nowBConditions"
                },
                {
                    "id": "nowBFeelsLike"
                },
                {
                    "id": "nowBHumidity"
                },
                {
                    "id": "nowBWind"
                }
            ]
        },
        "nowBConditions": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "conditions"
            }
        },
        "nowBFeelsLike": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "feelsLike"
            }
        },
        "nowBHumidity": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "humidity"
            }
        },
        "nowBWind": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "windSpeed"
            }
        },
        "tempChartB": {
            "component": "chart",
            "config": {
                "source": "forecastB",
                "title": "Temperature",
                "type": "line",
                "x": "time",
                "y": [
                    "temp",
                    "feelsLike"
                ]
            }
        },
        "precipChartA": {
            "component": "chart",
            "config": {
                "source": "forecastA",
                "title": "Precipitation",
                "type": "column",
                "x": "time",
                "y": [
                    "precipProbability"
                ],
                "y2": [
                    "precipVolume"
                ]
            }
        },
        "title": {
            "component": "markdown",
            "config": {
                "text": "# Global Weather Comparison Dashboard"
            }
        },
        "unitsToggle": {
            "component": "buttonGroupInput",
            "config": {
                "options": [
                    {
                        "value": "metric",
                        "label": "°C"
                    },
                    {
                        "value": "imperial",
                        "label": "°F"
                    }
                ]
            }
        }
    }
}
