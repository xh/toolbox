{
    "schema": {
        "blueprint": 1,
        "widgets": {
            "dashboard": 1,
            "gauge": 1,
            "tileFrame": 1,
            "statCard": 1,
            "chart": 1,
            "markdown": 1,
            "buttonGroupInput": 1
        }
    },
    "variables": {
        "cityA": {
            "type": "string",
            "label": "City A",
            "setBy": "prompt",
            "default": {
                "value": "New York"
            },
            "options": {
                "values": [
                    "Chicago",
                    "London",
                    "New York",
                    "Paris",
                    "Sydney",
                    "Tokyo"
                ]
            }
        },
        "cityB": {
            "type": "string",
            "label": "City B",
            "setBy": "prompt",
            "default": {
                "value": "London"
            },
            "options": {
                "values": [
                    "Chicago",
                    "London",
                    "New York",
                    "Paris",
                    "Sydney",
                    "Tokyo"
                ]
            }
        },
        "units": {
            "type": "string",
            "label": "Units",
            "setBy": {
                "element": "unitsToggle"
            },
            "default": {
                "value": "metric"
            }
        }
    },
    "sources": {
        "currentA": {
            "dataset": "currentWeather",
            "params": {
                "city": {
                    "$var": "cityA"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "forecastA": {
            "dataset": "weather",
            "params": {
                "city": {
                    "$var": "cityA"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "currentB": {
            "dataset": "currentWeather",
            "params": {
                "city": {
                    "$var": "cityB"
                },
                "units": {
                    "$var": "units"
                }
            }
        },
        "forecastB": {
            "dataset": "weather",
            "params": {
                "city": {
                    "$var": "cityB"
                },
                "units": {
                    "$var": "units"
                }
            }
        }
    },
    "root": "page",
    "elements": {
        "page": {"component": "panel", "tbar": [{"id": "cityAInput"}, {"id": "cityBInput"}, {"id": "unitsToggle"}], "children": [{"id": "dashboard"}]},
        "cityAInput": {"component": "variableInput", "config": {"variable": "cityA"}},
        "cityBInput": {"component": "variableInput", "config": {"variable": "cityB"}},
        "dashboard": {
            "component": "dashboard",
            "children": [
                {
                    "id": "title",
                    "x": 0,
                    "y": 0,
                    "w": 12,
                    "h": 1
                },
                {
                    "id": "nowA",
                    "x": 0,
                    "y": 1,
                    "w": 6,
                    "h": 3
                },
                {
                    "id": "humidityA",
                    "x": 0,
                    "y": 4,
                    "w": 2,
                    "h": 4
                },
                {
                    "id": "tempChartA",
                    "x": 2,
                    "y": 4,
                    "w": 4,
                    "h": 4
                },
                {
                    "id": "nowB",
                    "x": 6,
                    "y": 1,
                    "w": 6,
                    "h": 3
                },
                {
                    "id": "humidityB",
                    "x": 6,
                    "y": 4,
                    "w": 2,
                    "h": 4
                },
                {
                    "id": "tempChartB",
                    "x": 8,
                    "y": 4,
                    "w": 4,
                    "h": 4
                },
                {
                    "id": "precipChartA",
                    "x": 0,
                    "y": 8,
                    "w": 12,
                    "h": 4
                }
            ]
        },
        "humidityA": {
            "component": "gauge",
            "config": {
                "source": "currentA",
                "title": "Humidity",
                "value": "humidity",
                "min": 0,
                "max": 100,
                "stops": [
                    {
                        "at": 0,
                        "color": "#fdae61"
                    },
                    {
                        "at": 0.5,
                        "color": "#a6d96a"
                    },
                    {
                        "at": 1,
                        "color": "#4575b4"
                    }
                ]
            }
        },
        "nowA": {
            "component": "tileFrame",
            "config": {
                "title": {
                    "$var": "cityA"
                },
                "minTileWidth": 120
            },
            "children": [
                {
                    "id": "nowAConditions"
                },
                {
                    "id": "nowATemp"
                },
                {
                    "id": "nowAFeelsLike"
                },
                {
                    "id": "nowAWind"
                }
            ]
        },
        "nowAConditions": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "conditions"
            }
        },
        "nowATemp": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "temp"
            }
        },
        "nowAFeelsLike": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "feelsLike"
            }
        },
        "nowAWind": {
            "component": "statCard",
            "config": {
                "source": "currentA",
                "field": "windSpeed"
            }
        },
        "tempChartA": {
            "component": "chart",
            "config": {
                "source": "forecastA",
                "title": "Temperature",
                "type": "line",
                "x": "time",
                "y": [
                    "temp",
                    "feelsLike"
                ]
            }
        },
        "humidityB": {
            "component": "gauge",
            "config": {
                "source": "currentB",
                "title": "Humidity",
                "value": "humidity",
                "min": 0,
                "max": 100,
                "stops": [
                    {
                        "at": 0,
                        "color": "#fdae61"
                    },
                    {
                        "at": 0.5,
                        "color": "#a6d96a"
                    },
                    {
                        "at": 1,
                        "color": "#4575b4"
                    }
                ]
            }
        },
        "nowB": {
            "component": "tileFrame",
            "config": {
                "title": {
                    "$var": "cityB"
                },
                "minTileWidth": 120
            },
            "children": [
                {
                    "id": "nowBConditions"
                },
                {
                    "id": "nowBTemp"
                },
                {
                    "id": "nowBFeelsLike"
                },
                {
                    "id": "nowBWind"
                }
            ]
        },
        "nowBConditions": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "conditions"
            }
        },
        "nowBTemp": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "temp"
            }
        },
        "nowBFeelsLike": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "feelsLike"
            }
        },
        "nowBWind": {
            "component": "statCard",
            "config": {
                "source": "currentB",
                "field": "windSpeed"
            }
        },
        "tempChartB": {
            "component": "chart",
            "config": {
                "source": "forecastB",
                "title": "Temperature",
                "type": "line",
                "x": "time",
                "y": [
                    "temp",
                    "feelsLike"
                ]
            }
        },
        "precipChartA": {
            "component": "chart",
            "config": {
                "source": "forecastA",
                "title": "Precipitation",
                "type": "column",
                "x": "time",
                "y": [
                    "precipProbability"
                ],
                "y2": [
                    "precipVolume"
                ]
            }
        },
        "title": {
            "component": "markdown",
            "config": {
                "text": "# Global Weather Comparison Dashboard"
            }
        },
        "unitsToggle": {
            "component": "buttonGroupInput",
            "config": {
                "options": [
                    {
                        "value": "metric",
                        "label": "°C"
                    },
                    {
                        "value": "imperial",
                        "label": "°F"
                    }
                ]
            }
        }
    }
}
